include REPRODUCE.md LICENSE NOTICE CITATION.cff SOURCE_MANIFEST.json package.json
recursive-include docs *.md
recursive-include examples *.py *.mjs
recursive-include tests *.py *.mjs
recursive-include configs *.json
recursive-include integrations *.mjs
recursive-include integrations *.md
recursive-include reproduction *.py *.mjs *.json *.md
recursive-include dsh-plugin/harnessmm-desktop *.js *.mjs *.json *.md *.yml
prune dsh-plugin/harnessmm-desktop/node_modules
prune .venv
prune outputs
prune artifacts
prune external
