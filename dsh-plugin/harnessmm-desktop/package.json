{
  "name": "dsh-harnessmm",
  "version": "0.1.0",
  "description": "HarnessMM for the DeepSeek Harness desktop app — guarded decision reuse over the native tool surface: CHISEL action banks authored once, receipt-local guards, and certified native substitution of the slow reasoning callback.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.1-rc.2 || ^0.2.1-rc.3 || ^0.2.1-rc.4 || ^0.2.1-rc.5 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "category": "tools",
    "displayName": "HarnessMM",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.2.1-rc.5 || ^0.2.2-alpha.2",
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "compatible"
      },
      "profiles": [
        "headless",
        "web",
        "desktop"
      ]
    }
  }
}